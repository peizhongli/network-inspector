{
  "manifest_version": 3,
  "name": "Network Inspector",
  "version": "1.1.0",
  "description": "DevTools 网络面板增强：关键字搜索、自定义 Header 标记、JSON 树、响应下载与 cURL 复制；DevTools 关闭时可用页面注入模式补充抓包。",
  "minimum_chrome_version": "111",
  "permissions": [
    "scripting",
    "storage",
    "tabs",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Network Inspector（注入模式）"
  },
  "devtools_page": "devtools.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ]
}
